<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/video_problem_scan_remote_label"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <Spinner
            android:id="@+id/video_problem_scan_remote_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/video_problem_scan_folder_label"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <TextView
            android:id="@+id/video_problem_scan_folder_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="//remote/anime" />

        <Button
            android:id="@+id/video_problem_scan_choose_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_problem_scan_choose_folder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/video_problem_scan_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/video_problem_scan_start" />

            <Button
                android:id="@+id/video_problem_scan_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/video_problem_scan_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Scanning 3 / 40" />

        <Button
            android:id="@+id/video_problem_scan_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/video_problem_scan_share" />

        <TextView
            android:id="@+id/video_problem_scan_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true"
            tools:text="AUDIO\tshow/ep01.mkv\taudio/x-ms-wma jpn" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
